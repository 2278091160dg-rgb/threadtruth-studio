{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadtruth.local/schemas/style-preview-v2",
  "title": "ThreadTruth single-style six-pose preview evidence",
  "description": "A complete public record contains 24 unique style-owned action-0 sheets. Machine validation additionally recomputes source, runtime-rule, pack, prompt, native-receipt and image hashes. Visual layout and content require human review; pixel divisibility is not treated as proof.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "role", "status", "source", "identity_anchor", "rules", "ai_label", "previews"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "role": {"const": "style-preview"},
    "status": {"enum": ["prepared", "awaiting-human-review", "approved"]},
    "ai_label": {"const": "AI-generated style preview — not six independent final images."},
    "source": {"$ref": "#/$defs/sourceSet"},
    "identity_anchor": {"$ref": "#/$defs/identityAnchor"},
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_build", "modes_scenes", "safety_core", "style_router"],
      "properties": {
        "prompt_build": {"$ref": "#/$defs/rule"},
        "modes_scenes": {"$ref": "#/$defs/rule"},
        "safety_core": {"$ref": "#/$defs/rule"},
        "style_router": {"$ref": "#/$defs/rule"}
      }
    },
    "previews": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/preview"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "reviewer": {"type": "string", "pattern": "^github:[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^skills/threadtruth-studio/references/[a-z-]+\\.md$"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "pattern": "^docs/demo/primary-cases/white-hooded-puffer-vest-korean-cold/source-[1-4]-[a-z-]+\\.jpg$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "role": {"const": "garment-source"}
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_ref", "rights_sha256", "authorization", "assets"],
      "properties": {
        "rights_ref": {"const": "docs/demo/primary-cases/white-hooded-puffer-vest-korean-cold/rights.json"},
        "rights_sha256": {"$ref": "#/$defs/hash"},
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "declared_at", "declaration", "public_use_authorized", "project_media_policy_accepted", "source_model_display_authorized"],
          "properties": {
            "reviewer": {"$ref": "#/$defs/reviewer"},
            "declared_at": {"$ref": "#/$defs/time"},
            "declaration": {"type": "string", "minLength": 1},
            "public_use_authorized": {"const": true},
            "project_media_policy_accepted": {"const": true},
            "source_model_display_authorized": {"const": true}
          }
        },
        "assets": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "identityAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"const": "docs/demo/primary-cases/white-hooded-puffer-vest-korean-cold/look-1.jpg"},
        "sha256": {"$ref": "#/$defs/hash"},
        "role": {"const": "identity-only"}
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "pattern": "^skills/threadtruth-studio/references/styles/[a-z0-9-]+\\.pack\\.yaml$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "description", "master", "head_gaze", "row", "column", "scene"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
        "description": {"type": "string", "minLength": 1},
        "master": {"enum": ["SIDE_TURN_STANDING", "SIDE_LEANING_WALL", "UPRIGHT_SEATED", "FRONT_LIGHT_STEP", "SLIGHT_FORWARD_LEAN", "BACK_TURN_GLANCE"]},
        "head_gaze": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 1, "maximum": 2},
        "column": {"type": "integer", "minimum": 1, "maximum": 3},
        "scene": {"type": "string", "minLength": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "call_id", "generated_at", "prompt_sha256"],
      "properties": {
        "tool": {"const": "native-imagegen"},
        "call_id": {"$ref": "#/$defs/id"},
        "generated_at": {"$ref": "#/$defs/time"},
        "prompt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "poseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "product", "pose_layout", "identity_style", "ai_disclosure"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
        "product": {"const": "pass"},
        "pose_layout": {"const": "pass"},
        "identity_style": {"const": "pass"},
        "ai_disclosure": {"const": "pass"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "confirmation", "preview_sha256", "evidence_sha256", "public_use_approved", "poses"],
      "properties": {
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "reviewed_at": {"$ref": "#/$defs/time"},
        "confirmation": {"type": "string", "pattern": "^I reviewed the complete six-pose [a-z0-9-]+ preview against the authorized sources\\.$"},
        "preview_sha256": {"$ref": "#/$defs/hash"},
        "evidence_sha256": {"$ref": "#/$defs/hash"},
        "public_use_approved": {"const": true},
        "poses": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/poseReview"}}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "display_name", "pack", "mode", "visual", "negative_delta_add", "poses", "prompt_sha256"],
      "properties": {
        "style": {"$ref": "#/$defs/id"},
        "display_name": {"type": "string", "minLength": 1},
        "pack": {"$ref": "#/$defs/pack"},
        "mode": {"enum": ["B", "C", "D"]},
        "visual": {
          "type": "object", "additionalProperties": false, "required": ["mood", "persona", "lighting"],
          "properties": {"mood": {"type": "string"}, "persona": {"type": "string"}, "lighting": {"type": "string"}}
        },
        "negative_delta_add": {"type": "array", "items": {"type": "string"}},
        "poses": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/pose"}},
        "prompt_sha256": {"$ref": "#/$defs/hash"},
        "path": {"type": "string", "pattern": "^[a-z0-9-]+\\.jpg$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "original_sha256": {"$ref": "#/$defs/hash"},
        "width": {"type": "integer", "minimum": 600},
        "height": {"type": "integer", "minimum": 600},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "generation": {"$ref": "#/$defs/generation"},
        "human_review": {"$ref": "#/$defs/review"}
      },
      "dependentRequired": {
        "path": ["sha256", "original_sha256", "width", "height", "bytes", "generation"],
        "human_review": ["path", "sha256", "generation"]
      }
    }
  }
}
