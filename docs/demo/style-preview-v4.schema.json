{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadtruth.local/schemas/style-preview-v4",
  "title": "ThreadTruth native and fixed-card display preview evidence",
  "description": "Schema4 preserves exact native prompt and call binding and adds observed extraction and deterministic display cards. Python validation additionally checks paths, hashes, rectangles, layout, assets, source authorization and explicit human review. Geometry pass covers cards only, never native-grid qualification or visual preservation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "role",
    "status",
    "source",
    "identity_anchor",
    "rules",
    "ai_label",
    "previews"
  ],
  "properties": {
    "schema_version": {
      "const": "4.0"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "role": {
      "const": "style-preview"
    },
    "status": {
      "enum": [
        "prepared",
        "awaiting-human-review",
        "approved"
      ]
    },
    "ai_label": {
      "const": "AI-generated style preview — not six independent final images."
    },
    "source": {
      "$ref": "#/$defs/sourceSet"
    },
    "identity_anchor": {
      "$ref": "#/$defs/identityAnchor"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_build",
        "modes_scenes",
        "safety_core",
        "style_router"
      ],
      "properties": {
        "prompt_build": {
          "$ref": "#/$defs/rule"
        },
        "modes_scenes": {
          "$ref": "#/$defs/rule"
        },
        "safety_core": {
          "$ref": "#/$defs/rule"
        },
        "style_router": {
          "$ref": "#/$defs/rule"
        }
      }
    },
    "previews": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/preview"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^github:[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^skills/threadtruth-studio/references/[a-z-]+\\.md$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/demo/primary-cases/white-hooded-puffer-vest-korean-cold/source-[1-4]-[a-z-]+\\.jpg$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "role": {
          "const": "garment-source"
        }
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_ref",
        "rights_sha256",
        "authorization",
        "assets"
      ],
      "properties": {
        "rights_ref": {
          "const": "docs/demo/primary-cases/white-hooded-puffer-vest-korean-cold/rights.json"
        },
        "rights_sha256": {
          "$ref": "#/$defs/hash"
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "declared_at",
            "declaration",
            "public_use_authorized",
            "project_media_policy_accepted",
            "source_model_display_authorized"
          ],
          "properties": {
            "reviewer": {
              "$ref": "#/$defs/reviewer"
            },
            "declared_at": {
              "$ref": "#/$defs/time"
            },
            "declaration": {
              "type": "string",
              "minLength": 1
            },
            "public_use_authorized": {
              "const": true
            },
            "project_media_policy_accepted": {
              "const": true
            },
            "source_model_display_authorized": {
              "const": true
            }
          }
        },
        "assets": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "identityAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "const": "docs/demo/primary-cases/white-hooded-puffer-vest-korean-cold/look-1.jpg"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "role": {
          "const": "identity-only"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^skills/threadtruth-studio/references/styles/[a-z0-9-]+\\.pack\\.yaml$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "description",
        "master",
        "head_gaze",
        "row",
        "column",
        "scene"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "master": {
          "enum": [
            "SIDE_TURN_STANDING",
            "SIDE_LEANING_WALL",
            "UPRIGHT_SEATED",
            "FRONT_LIGHT_STEP",
            "SLIGHT_FORWARD_LEAN",
            "BACK_TURN_GLANCE"
          ]
        },
        "head_gaze": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "scene": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "call_id",
        "generated_at",
        "prompt_sha256"
      ],
      "properties": {
        "tool": {
          "const": "native-imagegen"
        },
        "call_id": {
          "$ref": "#/$defs/id"
        },
        "generated_at": {
          "$ref": "#/$defs/time"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason_code",
        "generation_prompt_sha256",
        "generation_authorization_sha256",
        "visual_acceptance_sha256",
        "replaces"
      ],
      "properties": {
        "kind": {"const": "targeted-correction"},
        "reason_code": {"const": "maintainer-requested-visual-fix"},
        "generation_prompt_sha256": {"$ref": "#/$defs/hash"},
        "generation_authorization_sha256": {"$ref": "#/$defs/hash"},
        "visual_acceptance_sha256": {"$ref": "#/$defs/hash"},
        "replaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["call_id", "original_sha256", "native_sha256", "display_sha256"],
          "properties": {
            "call_id": {"$ref": "#/$defs/id"},
            "original_sha256": {"$ref": "#/$defs/hash"},
            "native_sha256": {"$ref": "#/$defs/hash"},
            "display_sha256": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "poseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "product",
        "pose_layout",
        "identity_style",
        "ai_disclosure",
        "framing"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "product": {
          "const": "pass"
        },
        "pose_layout": {
          "const": "pass"
        },
        "identity_style": {
          "const": "pass"
        },
        "ai_disclosure": {
          "const": "pass"
        },
        "framing": {
          "const": "pass"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewed_at",
        "confirmation",
        "preview_sha256",
        "evidence_sha256",
        "public_use_approved",
        "poses",
        "original_sha256",
        "native_sha256",
        "composition_sha256",
        "geometry",
        "checks"
      ],
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewed_at": {
          "$ref": "#/$defs/time"
        },
        "confirmation": {
          "type": "string",
          "pattern": "^I reviewed the complete six-pose [a-z0-9-]+ preview against the authorized sources\\.$"
        },
        "preview_sha256": {
          "$ref": "#/$defs/hash"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/hash"
        },
        "public_use_approved": {
          "const": true
        },
        "poses": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/poseReview"
          }
        },
        "original_sha256": {
          "$ref": "#/$defs/hash"
        },
        "native_sha256": {
          "$ref": "#/$defs/hash"
        },
        "composition_sha256": {
          "$ref": "#/$defs/hash"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_boundaries",
            "full_bilingual_title",
            "correct_subtitle",
            "readable_ai_footer",
            "text_subject_non_overlap",
            "complete_panel_extraction",
            "padding_no_subject_loss",
            "derivative_disclosure"
          ],
          "properties": {
            "observed_boundaries": {
              "const": "pass"
            },
            "full_bilingual_title": {
              "const": "pass"
            },
            "correct_subtitle": {
              "const": "pass"
            },
            "readable_ai_footer": {
              "const": "pass"
            },
            "text_subject_non_overlap": {
              "const": "pass"
            },
            "complete_panel_extraction": {
              "const": "pass"
            },
            "padding_no_subject_loss": {
              "const": "pass"
            },
            "derivative_disclosure": {
              "const": "pass"
            }
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "display_name",
        "pack",
        "mode",
        "visual",
        "negative_delta_add",
        "poses",
        "prompt_sha256",
        "layout_contract",
        "label_contract",
        "display_contract"
      ],
      "properties": {
        "style": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "pack": {
          "$ref": "#/$defs/pack"
        },
        "mode": {
          "enum": [
            "B",
            "C",
            "D"
          ]
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mood",
            "persona",
            "lighting"
          ],
          "properties": {
            "mood": {
              "type": "string"
            },
            "persona": {
              "type": "string"
            },
            "lighting": {
              "type": "string"
            }
          }
        },
        "negative_delta_add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "poses": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/pose"
          }
        },
        "prompt_sha256": {
          "$ref": "#/$defs/hash"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.jpg$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "original_sha256": {
          "$ref": "#/$defs/hash"
        },
        "width": {
          "type": "integer",
          "minimum": 600
        },
        "height": {
          "type": "integer",
          "minimum": 600
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "correction": {
          "$ref": "#/$defs/correction"
        },
        "human_review": {
          "$ref": "#/$defs/review"
        },
        "layout_contract": {
          "type": "object"
        },
        "label_contract": {
          "type": "object"
        },
        "display_contract": {
          "type": "object"
        },
        "composition": {
          "$ref": "#/$defs/composition"
        }
      },
      "dependentRequired": {
        "path": [
          "sha256",
          "original_sha256",
          "width",
          "height",
          "bytes",
          "generation"
        ],
        "human_review": [
          "path",
          "sha256",
          "generation",
          "composition"
        ],
        "composition": [
          "path",
          "sha256",
          "generation"
        ],
        "correction": [
          "path",
          "sha256",
          "generation"
        ]
      }
    },
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cells": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/rect"
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "width",
        "height",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.jpg$"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "width": {
          "type": "integer",
          "minimum": 600
        },
        "height": {
          "type": "integer",
          "minimum": 600
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_sha256",
        "cells"
      ],
      "properties": {
        "original_sha256": {
          "$ref": "#/$defs/hash"
        },
        "cells": {
          "$ref": "#/$defs/cells"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "title",
        "subtitle",
        "footer"
      ],
      "properties": {
        "cells": {
          "$ref": "#/$defs/cells"
        },
        "title": {
          "$ref": "#/$defs/rect"
        },
        "subtitle": {
          "$ref": "#/$defs/rect"
        },
        "footer": {
          "$ref": "#/$defs/rect"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_sha256",
        "native_sha256",
        "native_dimensions",
        "generation",
        "layout_path",
        "layout_sha256",
        "observed_layout",
        "font_sha256",
        "font_name",
        "parameters",
        "geometry",
        "geometry_scope",
        "native_geometry",
        "transforms",
        "text",
        "display",
        "thumbnail"
      ],
      "properties": {
        "original_sha256": {
          "$ref": "#/$defs/hash"
        },
        "native_sha256": {
          "$ref": "#/$defs/hash"
        },
        "native_dimensions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 600
          }
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "layout_path": {
          "type": "string",
          "pattern": "^layouts/[a-z0-9-]+\\.json$"
        },
        "layout_sha256": {
          "$ref": "#/$defs/hash"
        },
        "observed_layout": {
          "$ref": "#/$defs/layout"
        },
        "font_sha256": {
          "$ref": "#/$defs/hash"
        },
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "geometry": {
          "const": "pass"
        },
        "geometry_scope": {
          "const": "deterministic-display-cards-only"
        },
        "native_geometry": {
          "const": "not-certified-by-composition"
        },
        "transforms": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "card",
              "scale",
              "fitted",
              "paste"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/rect"
              },
              "card": {
                "$ref": "#/$defs/rect"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "fitted": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "paste": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "text": {
          "type": "object",
          "required": [
            "title",
            "subtitle",
            "footer"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "text",
              "rendered",
              "font_size",
              "bounds"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "rendered": {
                "type": "string",
                "minLength": 1
              },
              "font_size": {
                "type": "integer",
                "minimum": 18,
                "maximum": 34
              },
              "bounds": {
                "$ref": "#/$defs/rect"
              }
            }
          }
        },
        "display": {
          "$ref": "#/$defs/asset"
        },
        "thumbnail": {
          "$ref": "#/$defs/asset"
        }
      }
    }
  }
}
