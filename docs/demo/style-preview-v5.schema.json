{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadtruth.local/schemas/style-preview-v5",
  "title": "ThreadTruth source-selected preview evidence",
  "description": "Schema 5 binds a selected controlled source, exact runtime rules, registered style packs, native generation evidence, deterministic display composition and human review. Python validation enforces hashes, paths, batch authorization and promotion state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "role", "status", "source", "identity_anchor", "rules", "ai_label", "batches", "previews"],
  "properties": {
    "schema_version": {"const": "5.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "role": {"const": "style-preview"},
    "status": {"enum": ["prepared", "awaiting-human-review", "approved"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "rights_ref", "rights_sha256", "assets", "subtitle", "outfit", "review_contract"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "rights_ref": {"type": "string", "pattern": "^docs/demo/preview-sources/[a-z0-9-]+/rights\\.json$"},
        "rights_sha256": {"$ref": "#/$defs/hash"},
        "assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceAsset"}},
        "subtitle": {"type": "string", "minLength": 1},
        "outfit": {"type": "object"},
        "review_contract": {"const": "coordinated-outfit-v1"}
      }
    },
    "identity_anchor": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sourceAsset"}]},
    "rules": {"type": "object"},
    "ai_label": {"type": "string"},
    "batches": {"type": "array", "minItems": 0, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/batch"}},
    "previews": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": {"type": "object", "properties": {"generation": {"$ref": "#/$defs/generation"}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "batch_id", "run_id", "styles", "maximum_calls", "authorization_sha256", "authorized_at", "scope"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "batch_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "styles": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "maximum_calls": {"type": "integer", "minimum": 1, "maximum": 6},
        "authorization_sha256": {"$ref": "#/$defs/hash"},
        "authorized_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "scope": {"const": "serial-native-generation;no-auto-retry"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "call_id", "generated_at", "prompt_sha256", "batch_id", "authorization_sha256", "model_docs_url", "model_docs_verified_at", "per_call_model"],
      "properties": {
        "tool": {"const": "native-imagegen"},
        "call_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "prompt_sha256": {"$ref": "#/$defs/hash"},
        "batch_id": {"$ref": "#/$defs/id"},
        "authorization_sha256": {"$ref": "#/$defs/hash"},
        "model_docs_url": {"const": "https://learn.chatgpt.com/docs/image-generation"},
        "model_docs_verified_at": {"const": "2026-09-14"},
        "per_call_model": {"const": "unavailable"}
      }
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["outfit-source", "identity-only"]},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
